"""
Trajectoire 3D de la pomme de terre, obtenue par triangulation stereo a
partir des deux trajectoires 2D (gauche et droite) deja calculees par
Traj_2D.py.

Principe :
  - Pour chaque frame, on dispose d'un point 2D corrige (sans distorsion)
    dans l'image gauche et d'un point 2D corrige dans l'image droite
    (colonnes cx_corrige/cy_corrige des CSV generes par Traj_2D.py).
  - On construit les matrices de projection :
        P_G = K_G . [I | 0]                (camera gauche = reference)
        P_D = K_D . [R | T]                (camera droite, relative a gauche)
  - cv2.triangulatePoints(P_G, P_D, pts_G, pts_D) donne le point 3D
    (en coordonnees homogenes) dans le repere de la camera gauche.

HYPOTHESE IMPORTANTE :
  R et T (dans CalibrationStereo.yml) sont supposes transformer un point du
  repere camera gauche vers le repere camera droite (X_D = R.X_G + T), ce
  qui est la convention habituelle de cv2.stereoCalibrate quand la camera
  gauche est passee en premier argument. Si la trajectoire 3D obtenue
  n'a pas de sens (echelle/orientation incoherente), c'est le premier
  endroit a verifier (essayer R.T et -R.T @ T, cf. INVERSER_RT ci-dessous).

Appariement des frames entre gauche et droite :
  - Par defaut, on essaie d'apparier par nom de frame identique (colonne
    "frame" des deux CSV).
  - Si aucun nom ne correspond (conventions de nommage differentes entre
    les deux dossiers), on se rabat automatiquement sur un appariement par
    position (meme index dans l'ordre des deux CSV), avec un avertissement.

Sorties (dans DOSSIER_SORTIE) :
  trajectoire_3d.csv         : frame, X, Y, Z
  trajectoire_3d.png         : trajectoire 3D (statique) + projections XY/XZ/YZ
  trajectoire_3d.html        : trajectoire 3D INTERACTIVE (plotly) -> a ouvrir
                               dans un navigateur pour tourner/zoomer/se
                               deplacer autour du nuage de points a la souris.

Necessite le module "plotly" pour le graphique interactif :
    pip install plotly

A ADAPTER : la section PARAMETRES ci-dessous.
"""

import cv2
import numpy as np
import os
import csv
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D  # noqa: F401 (necessaire pour projection="3d")

try:
    import plotly.graph_objects as go
    PLOTLY_DISPONIBLE = True
except ImportError:
    PLOTLY_DISPONIBLE = False

# ==========================================================================
# PARAMETRES A ADAPTER
# ==========================================================================

CALIBRATION_YML = "CalibrationStereo.yml"

CSV_GAUCHE = os.path.join("trajectoire", "trajectoire_gauche", "trajectoire_2d.csv")
CSV_DROITE = os.path.join("trajectoire", "trajectoire_droite", "trajectoire_2d.csv")

DOSSIER_SORTIE = "trajectoire_3d"

# Si la trajectoire 3D semble "inversee" ou incoherente, essayer de passer
# ceci a True (echange le sens de R/T, au cas ou ils transforment droite -> gauche
# plutot que gauche -> droite).
INVERSER_RT = False


# ==========================================================================
# CHARGEMENT DU CALIBRAGE STEREO
# ==========================================================================
def charger_calibrage_stereo(path_yml):
    fs = cv2.FileStorage(path_yml, cv2.FILE_STORAGE_READ)
    if not fs.isOpened():
        raise RuntimeError(f"Impossible d'ouvrir {path_yml}")

    K_G = fs.getNode("K_G").mat()
    dist_G = fs.getNode("dist_G").mat()
    K_D = fs.getNode("K_D").mat()
    dist_D = fs.getNode("dist_D").mat()
    R = fs.getNode("R").mat()
    T = fs.getNode("T").mat()
    fs.release()

    manquants = [nom for nom, val in
                 [("K_G", K_G), ("dist_G", dist_G), ("K_D", K_D),
                  ("dist_D", dist_D), ("R", R), ("T", T)]
                 if val is None]
    if manquants:
        raise RuntimeError(
            f"Cles introuvables dans {path_yml} : {', '.join(manquants)}. "
            "Verifie les noms exacts des cles dans le fichier yml et adapte "
            "charger_calibrage_stereo() en consequence."
        )

    return K_G, dist_G, K_D, dist_D, R, T


# ==========================================================================
# LECTURE DES TRAJECTOIRES 2D (CSV generes par Traj_2D.py)
# ==========================================================================
def lire_trajectoire_2d(path_csv):
    lignes = []
    with open(path_csv, "r", newline="", encoding="utf-8") as f:
        reader = csv.DictReader(f)
        for row in reader:
            lignes.append({
                "frame": row["frame"],
                "cx": float(row["cx_corrige"]),
                "cy": float(row["cy_corrige"]),
            })
    return lignes


def apparier_frames(traj_g, traj_d):
    """
    Renvoie une liste de tuples (frame_label, pt_G, pt_D).
    Essaie d'abord un appariement par nom de frame identique ; si aucune
    correspondance n'est trouvee, se rabat sur l'appariement par position.
    """
    dict_g = {t["frame"]: t for t in traj_g}
    dict_d = {t["frame"]: t for t in traj_d}
    noms_communs = [f for f in dict_g if f in dict_d]

    paires = []
    if noms_communs:
        print(f"Appariement par nom de frame : {len(noms_communs)} correspondances trouvees.")
        for nom in sorted(noms_communs):
            g, d = dict_g[nom], dict_d[nom]
            paires.append((nom, (g["cx"], g["cy"]), (d["cx"], d["cy"])))
    else:
        n = min(len(traj_g), len(traj_d))
        print(f"AVERTISSEMENT : aucun nom de frame commun entre gauche et droite. "
              f"Appariement par position (index) sur {n} frames. "
              f"Verifie que les deux dossiers d'images sont bien synchronises.")
        for i in range(n):
            g, d = traj_g[i], traj_d[i]
            paires.append((g["frame"], (g["cx"], g["cy"]), (d["cx"], d["cy"])))

    return paires


# ==========================================================================
# TRIANGULATION
# ==========================================================================
def construire_projections(K_G, K_D, R, T, inverser=False):
    if inverser:
        R = R.T
        T = -R @ T

    P_G = K_G @ np.hstack([np.eye(3), np.zeros((3, 1))])
    P_D = K_D @ np.hstack([R, T.reshape(3, 1)])
    return P_G, P_D


def trianguler(paires, P_G, P_D):
    pts_G = np.array([[p[1][0], p[1][1]] for p in paires], dtype=np.float64).T  # 2xN
    pts_D = np.array([[p[2][0], p[2][1]] for p in paires], dtype=np.float64).T  # 2xN

    points_4d = cv2.triangulatePoints(P_G, P_D, pts_G, pts_D)  # 4xN homogene
    points_3d = (points_4d[:3] / points_4d[3]).T  # Nx3

    return points_3d


# ==========================================================================
# PROGRAMME PRINCIPAL
# ==========================================================================
os.makedirs(DOSSIER_SORTIE, exist_ok=True)

K_G, dist_G, K_D, dist_D, R, T = charger_calibrage_stereo(CALIBRATION_YML)

traj_g = lire_trajectoire_2d(CSV_GAUCHE)
traj_d = lire_trajectoire_2d(CSV_DROITE)
print(f"Trajectoire gauche : {len(traj_g)} frames")
print(f"Trajectoire droite : {len(traj_d)} frames")

paires = apparier_frames(traj_g, traj_d)
if not paires:
    raise RuntimeError("Aucune paire de points gauche/droite a trianguler.")

P_G, P_D = construire_projections(K_G, K_D, R, T, inverser=INVERSER_RT)
points_3d = trianguler(paires, P_G, P_D)

# ==========================================================================
# SAUVEGARDE CSV
# ==========================================================================
csv_path = os.path.join(DOSSIER_SORTIE, "trajectoire_3d.csv")
with open(csv_path, "w", newline="", encoding="utf-8") as f:
    writer = csv.writer(f)
    writer.writerow(["frame", "X", "Y", "Z"])
    for (nom, _, _), pt in zip(paires, points_3d):
        writer.writerow([nom, pt[0], pt[1], pt[2]])
print("Trajectoire 3D sauvegardee dans", csv_path)

# ==========================================================================
# VISUALISATION : trajectoire 3D + projections XY / XZ / YZ
# ==========================================================================
X, Y, Z = points_3d[:, 0], points_3d[:, 1], points_3d[:, 2]
n = len(points_3d)
couleurs = range(n)

fig = plt.figure(figsize=(13, 10))

ax3d = fig.add_subplot(2, 2, 1, projection="3d")
sc = ax3d.scatter(X, Y, Z, c=couleurs, cmap="viridis", s=15)
ax3d.plot(X, Y, Z, color="gray", alpha=0.4, linewidth=1)
ax3d.set_xlabel("X")
ax3d.set_ylabel("Y")
ax3d.set_zlabel("Z")
ax3d.set_title("Trajectoire 3D")
fig.colorbar(sc, ax=ax3d, shrink=0.6, label="frame (temps)")

ax_xy = fig.add_subplot(2, 2, 2)
ax_xy.scatter(X, Y, c=couleurs, cmap="viridis", s=12)
ax_xy.plot(X, Y, color="gray", alpha=0.4, linewidth=1)
ax_xy.set_title("Vue de dessus (XY)")
ax_xy.set_xlabel("X")
ax_xy.set_ylabel("Y")
ax_xy.set_aspect("equal")

ax_xz = fig.add_subplot(2, 2, 3)
ax_xz.scatter(X, Z, c=couleurs, cmap="viridis", s=12)
ax_xz.plot(X, Z, color="gray", alpha=0.4, linewidth=1)
ax_xz.set_title("Vue de face (XZ)")
ax_xz.set_xlabel("X")
ax_xz.set_ylabel("Z")
ax_xz.set_aspect("equal")

ax_yz = fig.add_subplot(2, 2, 4)
ax_yz.scatter(Y, Z, c=couleurs, cmap="viridis", s=12)
ax_yz.plot(Y, Z, color="gray", alpha=0.4, linewidth=1)
ax_yz.set_title("Vue de cote (YZ)")
ax_yz.set_xlabel("Y")
ax_yz.set_ylabel("Z")
ax_yz.set_aspect("equal")

plt.tight_layout()
png_path = os.path.join(DOSSIER_SORTIE, "trajectoire_3d.png")
plt.savefig(png_path, dpi=150)
print("Graphique sauvegarde dans", png_path)

# ==========================================================================
# VISUALISATION INTERACTIVE (plotly) : a ouvrir dans un navigateur pour
# tourner/zoomer/se deplacer autour du nuage de points 3D a la souris.
# ==========================================================================
if PLOTLY_DISPONIBLE:
    noms_frames = [p[0] for p in paires]

    fig_i = go.Figure(data=[
        go.Scatter3d(
            x=X, y=Y, z=Z,
            mode="markers+lines",
            marker=dict(
                size=4,
                color=list(couleurs),
                colorscale="Viridis",
                colorbar=dict(title="frame (temps)"),
            ),
            line=dict(color="gray", width=2),
            text=noms_frames,
            hovertemplate="frame=%{text}<br>X=%{x:.2f}<br>Y=%{y:.2f}<br>Z=%{z:.2f}<extra></extra>",
        )
    ])
    fig_i.update_layout(
        title="Trajectoire 3D (interactive)",
        scene=dict(
            xaxis_title="X",
            yaxis_title="Y",
            zaxis_title="Z",
            aspectmode="data",  # respecte les proportions reelles X/Y/Z
        ),
        margin=dict(l=0, r=0, b=0, t=40),
    )

    html_path = os.path.join(DOSSIER_SORTIE, "trajectoire_3d.html")
    fig_i.write_html(html_path)
    print("Graphique interactif sauvegarde dans", html_path,
          "(ouvrir dans un navigateur pour tourner/zoomer)")
else:
    print("plotly non installe : graphique interactif non genere. "
          "Installe-le avec 'pip install plotly' pour l'obtenir.")

print("\n====================")
print(f"Triangulation terminee : {n} points 3D")
print(f"Resultats dans : {DOSSIER_SORTIE}/")
print("====================")

# Ouvre une fenetre matplotlib interactive (rotation a la souris) en plus des
# fichiers deja sauvegardes (png, html). Necessite un environnement avec
# affichage graphique (ne fonctionne pas sur un serveur/terminal sans GUI).
plt.show()